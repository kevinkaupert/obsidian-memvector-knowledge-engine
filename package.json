{
  "name": "obsidian-memvector-knowledge-engine",
  "version": "0.1.1",
  "description": "Local-first 2D vector-space graph, SQLite graph engine, and hybrid GraphRAG AI co-pilot for Obsidian — powered by Ollama, Anthropic Claude, OpenAI, or DeepSeek.",
  "main": "main.js",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --external:obsidian --external:electron --format=cjs --target=es2020 --platform=browser --outfile=main.js --watch",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --external:obsidian --external:electron --format=cjs --target=es2020 --platform=browser --outfile=main.js --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "memvector",
    "vector-search",
    "knowledge-graph",
    "graphrag",
    "sqlite",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinkaupert/obsidian-memvector-knowledge-engine.git"
  },
  "bugs": {
    "url": "https://github.com/kevinkaupert/obsidian-memvector-knowledge-engine/issues"
  },
  "homepage": "https://github.com/kevinkaupert/obsidian-memvector-knowledge-engine#readme",
  "author": "Kevin Mike Kaupert",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.5.7",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
